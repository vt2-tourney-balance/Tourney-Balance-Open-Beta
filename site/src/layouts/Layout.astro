---
const base = import.meta.env.BASE_URL;
const logo = `${base}logo_vt2.png`;

// @font-face can't use CSS custom properties (define:vars) since it isn't
// tied to any element for var() to resolve against — build the base-prefixed
// paths as plain strings instead and inject as raw, unscoped CSS below.
const fontFaceCSS = `
  @font-face {
    font-family: 'Caslon Antique';
    src: url('${base}fonts/CaslonAntique/CaslonAntique.ttf') format('truetype');
    font-display: swap;
  }
  @font-face {
    font-family: 'Tiepolo';
    src: url('${base}fonts/Tiepolo/Tiepolo.ttf') format('truetype');
    font-display: swap;
  }
`;

interface Props {
  title: string;
  fullBleed?: boolean;
}
const { title, fullBleed = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}favicon.ico`} />
    <title>{title} — Tourney Balance</title>
  </head>
  <body>
    <header class="site-header">
      <a href={base} class="logo-link">
        <img src={logo} alt="Tourney Balance" class="logo" />
      </a>
      <nav class="site-nav">
        <a href={`${base}changes/`}>Balance Changes</a>
        <a href={`${base}patch-notes/`}>Patch Notes</a>
        <a href={`${base}documentation/`}>Documentation</a>
        <a href="https://miro.com/app/board/uXjVHZWgcfU=/">Miro Board ↗</a>
      </nav>
    </header>
    <main class={fullBleed ? 'full-bleed' : ''}>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Tourney Balance is not affiliated with Fatshark or Games Workshop.</p>
    </footer>
  </body>
</html>

<style set:html={fontFaceCSS}></style>

<style>
  :global(:root) {
    --color-bg: #121212;
    --color-text: #dfdfdf;
    --color-accent: #e69e00;
    --header-height: 72px;
  }

  :global(html) {
    /* Reserves the scrollbar's width permanently, so pages with and without
       a scrollbar don't shift the content width when navigating between them. */
    scrollbar-gutter: stable;
    overflow-y: scroll;
  }

  :global(body) {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: 'Tiepolo', serif;
    line-height: 1.6;
  }

  :global(h1),
  :global(h2),
  :global(h3) {
    font-family: 'Caslon Antique', serif;
    color: var(--color-accent);
  }

  :global(a) {
    color: var(--color-accent);
  }

  :global(details summary) {
    cursor: pointer;
    color: var(--color-accent);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    border-bottom: 2px solid var(--color-accent);
    background: rgba(18, 18, 18, 0.7);
    box-sizing: border-box;
    height: var(--header-height);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .logo {
    height: 32px;
    display: block;
    transition: filter 0.2s ease;
  }

  .logo-link:hover .logo {
    filter: drop-shadow(0 0 4px #fff) drop-shadow(0 0 8px #fff);
  }

  .site-nav {
    display: flex;
    gap: 1.5rem;
  }

  .site-nav a {
    color: var(--color-text);
    text-decoration: none;
  }
  .site-nav a:hover {
    color: var(--color-accent);
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
    min-height: 60vh;
  }

  /* Used for pages with their own full-bleed hero content, so it can butt
     up flush against the header/footer with no transparent padding gap
     revealing whatever sits behind (e.g. the homepage's fixed hero video). */
  main.full-bleed {
    padding-top: 0;
    padding-bottom: 0;
  }

  .site-footer {
    text-align: center;
    padding: 2rem;
    font-size: 0.85rem;
    background: rgba(18, 18, 18, 0.7);
  }

  .site-footer p {
    opacity: 0.7;
  }
</style>
