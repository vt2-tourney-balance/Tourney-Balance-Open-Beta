---
import BalanceChangesLayout from '../../layouts/BalanceChangesLayout.astro';
import { getSortedBalanceChanges } from '../../lib/balanceChanges';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const careers = await getSortedBalanceChanges();
  return careers.map(({ entry, slug }) => ({
    params: { slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BalanceChangesLayout title={entry.data.title} activeSlug={Astro.params.slug}>
  <h1>{entry.data.title}</h1>
  <Content />
</BalanceChangesLayout>
