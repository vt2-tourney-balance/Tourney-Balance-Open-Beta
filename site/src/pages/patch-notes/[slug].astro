---
import PatchNotesLayout from '../../layouts/PatchNotesLayout.astro';
import { getSortedPatchNotes } from '../../lib/patchNotes';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getSortedPatchNotes();
  return notes.map(({ entry, slug }) => ({
    params: { slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PatchNotesLayout title={entry.data.title} activeSlug={Astro.params.slug}>
  <p class="patch-date">
    {
      entry.data.date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })
    }
  </p>
  <Content />
</PatchNotesLayout>

<style>
  .patch-date {
    opacity: 0.7;
    font-size: 0.9rem;
    margin-top: -0.5rem;
  }
</style>
