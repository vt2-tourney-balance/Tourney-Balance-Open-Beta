---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Home">
  <h1>Welcome to Tourney Balance</h1>
  <p>
    Tourney Balance is a competitive balance mod for Warhammer: Vermintide 2,
    maintained for the tournament and modded scene. This site documents the
    mod's patch history and how its balance changes differ from official.
  </p>
  <p>
    <a href={`${base}patch-notes/`}>Read the Patch Notes →</a>
  </p>
</Layout>
