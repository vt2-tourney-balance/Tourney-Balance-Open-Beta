---
import { getSortedPatchNotes } from '../lib/patchNotes';

interface Props {
  activeSlug?: string;
}
const { activeSlug } = Astro.props;

const base = import.meta.env.BASE_URL;
const notes = await getSortedPatchNotes();
---

<div class="patch-sidebar-wrapper">
  <button
    type="button"
    id="patch-sidebar-toggle"
    class="patch-sidebar-toggle"
    aria-expanded="true"
    aria-controls="patch-sidebar"
  >
    ☰
  </button>
  <aside id="patch-sidebar" class="patch-sidebar">
    <input
      type="search"
      id="patch-sidebar-search"
      class="patch-sidebar-search"
      placeholder="Search patch notes..."
      aria-label="Search patch notes"
    />
    <ul class="patch-sidebar-list" id="patch-sidebar-list">
      {
        notes.map(({ entry, slug }) => (
          <li>
            <a
              href={`${base}patch-notes/${slug}/`}
              class={slug === activeSlug ? 'active' : ''}
              data-title={entry.data.title.toLowerCase()}
              data-body={(entry.body ?? '').toLowerCase()}
            >
              <span class="patch-sidebar-item-title">{entry.data.title}</span>
              <span class="patch-sidebar-item-date">
                {entry.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </aside>
</div>

<script>
  const toggle = document.getElementById('patch-sidebar-toggle');
  const wrapper = toggle?.closest('.patch-sidebar-wrapper');
  const isMobile = () => window.matchMedia('(max-width: 768px)').matches;

  toggle?.addEventListener('click', () => {
    const hasCollapsedClass = wrapper?.classList.toggle('collapsed');
    // On desktop ".collapsed" hides an initially-shown sidebar; on mobile it
    // reveals an initially-hidden one — same class, opposite meaning below
    // the breakpoint, so aria-expanded is computed accordingly either way.
    const isExpanded = isMobile() ? hasCollapsedClass : !hasCollapsedClass;
    toggle.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
  });

  const search = document.getElementById('patch-sidebar-search') as HTMLInputElement | null;
  const items = document.querySelectorAll<HTMLLIElement>('#patch-sidebar-list li');

  search?.addEventListener('input', () => {
    const query = search.value.trim().toLowerCase();
    items.forEach((item) => {
      const link = item.querySelector('a');
      const title = link?.getAttribute('data-title') ?? '';
      const body = link?.getAttribute('data-body') ?? '';
      const matches = !query || title.includes(query) || body.includes(query);
      item.style.display = matches ? '' : 'none';
    });
  });
</script>

<style>
  .patch-sidebar-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    position: sticky;
    /* Matches where it naturally sat before (below the header plus main's
       own top padding), rather than snapping flush to the header. */
    top: calc(var(--header-height) + 2rem);
    z-index: 5;
  }

  .patch-sidebar-toggle {
    background: none;
    border: 1px solid #333;
    color: var(--color-text);
    border-radius: 4px;
    padding: 0.4rem 0.6rem;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
  }
  .patch-sidebar-toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .patch-sidebar {
    width: 240px;
    flex-shrink: 0;
    overflow: hidden;
    transition:
      width 0.15s ease,
      opacity 0.15s ease;
  }

  .patch-sidebar-wrapper.collapsed .patch-sidebar {
    width: 0;
    opacity: 0;
  }

  @media (max-width: 768px) {
    .patch-sidebar-wrapper {
      /* Children below are fixed-positioned overlays, so the wrapper itself
         contributes no size to the document flow — no more empty gap
         before the main content starts. */
      position: static;
      width: auto;
      display: block;
    }

    .patch-sidebar-toggle {
      /* Always reachable at the same spot on screen, regardless of scroll
         position — matches the desktop sticky behavior. */
      position: fixed;
      top: calc(var(--header-height) + 1rem);
      left: 1rem;
      z-index: 20;
    }

    .patch-sidebar {
      /* Hidden off-canvas by default; slides in from the right as an
         overlay on top of the main content instead of pushing it aside. */
      position: fixed;
      top: var(--header-height);
      right: 0;
      width: min(85vw, 320px);
      height: calc(100vh - var(--header-height));
      background: rgba(18, 18, 18, 0.98);
      box-shadow: -4px 0 16px rgba(0, 0, 0, 0.4);
      padding: 1rem;
      box-sizing: border-box;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.2s ease;
      opacity: 1;
      z-index: 15;
    }

    /* Same toggle class as desktop, but inverted meaning: here it reveals
       the sidebar instead of hiding it (see the isMobile() check in the
       script below, which keeps aria-expanded correct either way).
       Explicitly overrides width/opacity from the desktop collapsed rule
       above — same selector, so both would otherwise apply at once here. */
    .patch-sidebar-wrapper.collapsed .patch-sidebar {
      transform: translateX(0);
      width: min(85vw, 320px);
      opacity: 1;
    }
  }

  .patch-sidebar-search {
    width: 100%;
    box-sizing: border-box;
    background: #1a1a1a;
    border: 1px solid #333;
    color: var(--color-text);
    padding: 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }
  .patch-sidebar-search:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .patch-sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 70vh;
    overflow-y: auto;
  }

  .patch-sidebar-list a {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.4rem;
    text-decoration: none;
    color: var(--color-text);
    border-radius: 4px;
    white-space: nowrap;
  }
  .patch-sidebar-list a:hover {
    background: #1a1a1a;
  }
  .patch-sidebar-list a.active {
    color: var(--color-accent);
    background: #1a1a1a;
  }

  .patch-sidebar-item-date {
    opacity: 0.6;
    font-size: 0.8rem;
  }
</style>
